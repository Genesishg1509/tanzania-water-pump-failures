# Data (too large / not versioned)
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet

# Reports / artifacts
# NOTE: reports/figures/*.png is deliberately NOT ignored — those figures are
# embedded in the README, so they must be versioned for GitHub to render them.
*.html
submission.csv
submission_*.csv
models/*.pkl
models/*.joblib

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# OS / editors
.DS_Store
.vscode/

# Throwaway scratch scripts — anchored to the repo root on purpose.
# An unanchored `_*.py` also matches `__init__.py`, which silently kept
# src/__init__.py out of every clone.
/_*.py
/_commitmsg.txt

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/figures/.gitkeep
